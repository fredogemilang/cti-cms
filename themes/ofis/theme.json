{
    "name": "OFIS Smart Office",
    "slug": "ofis",
    "version": "1.0.0",
    "description": "OFIS Smart Office Theme for CTI CMS",
    "author": "Blue Power Technology",
    "screenshot": "screenshot.png",
    "supports": [
        "pages",
        "menus"
    ],
    "page_templates": {
        "default": {
            "label": "Default Page",
            "description": "Standard page layout with container wrapper",
            "blocks": []
        },
        "home": {
            "label": "Homepage",
            "description": "OFIS Smart Office main landing page",
            "blocks": [
                {
                    "name": "hero_title",
                    "type": "text",
                    "label": "Hero Title",
                    "default": "One Future of Interconnected workspace for Smart workforce"
                },
                {
                    "name": "hero_subtitle",
                    "type": "textarea",
                    "label": "Hero Subtitle",
                    "default": "Empower your workplace with smart office technology for better efficiency and productivity."
                },
                {
                    "name": "hero_cta_text",
                    "type": "text",
                    "label": "Hero CTA Button Text",
                    "default": "Explore Packages"
                },
                {
                    "name": "hero_cta_url",
                    "type": "text",
                    "label": "Hero CTA Button Link",
                    "default": "#packages"
                }
            ]
        },
        "package-single": {
            "label": "Package Single Detail",
            "description": "Solution package detail view",
            "blocks": []
        },
        "blog-index": {
            "label": "Blog Listing",
            "description": "Blog articles archive page",
            "blocks": []
        }
    },
    "menu_locations": {
        "primary": "Primary Header Navigation",
        "footer": "Footer Navigation"
    }
}
