{
    "name": "CDT Theme",
    "slug": "cdt",
    "version": "1.0.0",
    "description": "Central Data Technology corporate theme featuring clean design, CPT relationships, dynamic mega menu, and form builder integration.",
    "author": "CDT Team",
    "supports": [
        "pages",
        "posts",
        "menus"
    ],
    "custom_field_types": [
        {
            "type": "vendor_solutions",
            "label": "Vendor Solutions",
            "icon": "category",
            "category": "dynamic",
            "description": "Dropdown otomatis terisi dari sub-products vendor yang sedang ditampilkan. Jika vendor tidak punya sub-products, fallback ke opsi default (Cloud Services, Consulting, Other)."
        }
    ],
    "form_placeholders": [
        {
            "key": "contact_form",
            "label": "Contact Form",
            "description": "Form displayed on the main contact page."
        },
        {
            "key": "job_application_form",
            "label": "Job Application Form",
            "description": "Form displayed on single job vacancy detail pages."
        },
        {
            "key": "gated_content_form",
            "label": "Resource / Datasheet Download Form",
            "description": "Form displayed on sub-product and sub-solution datasheet pages."
        },
        {
            "key": "alliance_form",
            "label": "Technology Alliance & Product Form",
            "description": "Form displayed on technology alliance and product detail pages."
        },
        {
            "key": "newsletter_form",
            "label": "Newsletter Subscription Form",
            "description": "Form displayed inside the footer newsletter subscription modal."
        }
