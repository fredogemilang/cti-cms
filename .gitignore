# ── Core boundary (allowlist) ─────────────────────────────
# main tracks ONLY core themes/plugins. Each project/<name> branch MUST
# un-ignore its own theme/plugins, e.g. on project/cdt:
#   !/themes/cdt  !/public/themes/cdt  !/plugins/youtube
/themes/*
!/themes/default
/public/themes/*
/plugins/*
!/plugins/posts
!/plugins/google-site-kit
# project/cdt
!/themes/cdt
!/public/themes/cdt
!/plugins/youtube

