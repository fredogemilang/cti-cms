{
    "name": "YouTube Videos",
    "slug": "youtube",
    "version": "1.0.0",
    "description": "YouTube channel video integration with featured video and playlist filtering.",
    "author": "CMS Team",
    "namespace": "Plugins\\Youtube",
    "provider": "Plugins\\Youtube\\Providers\\YoutubeServiceProvider",
    "permissions": {
        "resources": [
            {
                "module": "youtube",
                "actions": ["view", "create", "edit", "delete"],
                "icon": "play_circle",
                "description": "Manage YouTube videos and playlists"
            },
            {
                "module": "youtube-settings",
                "actions": ["view", "edit"],
                "icon": "settings",
                "description": "Manage YouTube plugin settings"
            }
        ]
    },
    "requires": {
        "php": ">=8.2",
        "cms": ">=1.0"
    }
}
