# ==========================================
# LiteSpeed Web Server Cache Module
# ==========================================
<IfModule LiteSpeed>
    CacheLookup on
    RewriteEngine On
    # Bypass LiteSpeed cache for logged-in users / admins (ensures Admin Bar renders)
    RewriteCond %{HTTP_COOKIE} cms_logged_in [NC]
    RewriteRule .* - [E=Cache-Control:no-cache]
</IfModule>

# ==========================================
# Browser Caching (mod_expires)
# ==========================================
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"

    # Images
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 month"

    # CSS & JavaScript
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"

    # Fonts
    ExpiresByType font/woff2 "access plus 1 month"
    ExpiresByType font/woff "access plus 1 month"
    ExpiresByType application/font-woff2 "access plus 1 month"
    ExpiresByType application/font-woff "access plus 1 month"
    ExpiresByType font/ttf "access plus 1 month"
    ExpiresByType font/otf "access plus 1 month"

    # HTML
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# ==========================================
# Cache-Control Headers (mod_headers)
# ==========================================
<IfModule mod_headers.c>
    # Static assets: 1 month cache
    <FilesMatch "\.(ico|jpe?g|png|gif|webp|svg|css|js|woff2?|ttf|otf|eot)$">
        Header set Cache-Control "public, max-age=2592000, immutable"
    </FilesMatch>

    # HTML Cache-Control is managed in PHP (SecurityHeaders middleware):
    # public pages get `no-cache` (bfcache + revalidation), admin gets `no-store`.
    # Keeping it out of mod_headers avoids a header race with the app layer.
</IfModule>

# ==========================================
# GZIP Compression (mod_deflate)
# ==========================================
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE font/woff
    AddOutputFilterByType DEFLATE font/woff2
    AddOutputFilterByType DEFLATE application/font-woff
    AddOutputFilterByType DEFLATE application/font-woff2
    AddOutputFilterByType DEFLATE font/ttf
    AddOutputFilterByType DEFLATE font/otf
</IfModule>

# ==========================================
# Remove ETags
# ==========================================
<IfModule mod_headers.c>
    Header unset ETag
</IfModule>
FileETag None

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # ==========================================
    # 301 Redirect Map — Legacy URL WordPress → Laravel
    # WAJIB berada SEBELUM blok "Tambahkan trailing slash".
    # Pola ^xxx/?$ mencocokkan versi dengan dan tanpa trailing slash sekaligus.
    # Semua TUJUAN berakhiran '/' sesuai keputusan trailing slash.
    # ==========================================

    # --- Halaman karier (20 URL, sengaja dihapus — jadi modal) ---
    RewriteRule ^career/?$ /careers/ [R=301,L]
    RewriteRule ^careers/(product-specialist-aws|manager-solution-architect|senior-competency-compliance|account-executive|solution-architect-observability|product-specialist-security|solution-architect-aws|cloud-engineer|solution-delivery-infrastructure|team-leader-product)/?$ /careers/ [R=301,L]
    RewriteRule ^id/careers/(product-specialist-aws|manager-solution-architect|senior-competency-compliance|account-executive|solution-architect-observability|product-specialist-security|solution-architect-aws|cloud-engineer|solution-delivery-infrastructure|team-leader-product)/?$ /id/karir/ [R=301,L]

    # --- Produk NetGain: flat → bersarang ---
    RewriteRule ^netgain-application-performance-management-apm/?$ /netgain-systems/netgain-systems-netgain-apm/ [R=301,L]
    RewriteRule ^netgain-network-traffic-analytics-nta/?$ /netgain-systems/netgain-systems-netgain-nta/ [R=301,L]
    RewriteRule ^netgain-network-configuration-monitoring-ncm/?$ /netgain-systems/netgain-systems-netgain-ncm/ [R=301,L]
    RewriteRule ^netgain-security-analytics-siem/?$ /netgain-systems/netgain-systems-netgain-siem/ [R=301,L]
    RewriteRule ^id/netgain-application-performance-management-apm/?$ /id/netgain-systems/netgain-systems-netgain-apm/ [R=301,L]
    RewriteRule ^id/netgain-network-traffic-analytics-nta/?$ /id/netgain-systems/netgain-systems-netgain-nta/ [R=301,L]
    RewriteRule ^id/netgain-network-configuration-monitoring-ncm/?$ /id/netgain-systems/netgain-systems-netgain-ncm/ [R=301,L]
    RewriteRule ^id/netgain-security-analytics-siem/?$ /id/netgain-systems/netgain-systems-netgain-siem/ [R=301,L]

    # --- Produk TiDB: flat → bersarang ---
    RewriteRule ^tidb-cloud-essentials/?$ /tidb/tidb-cloud-essentials/ [R=301,L]
    RewriteRule ^tidb-enterprise-self-managed/?$ /tidb/tidb-enterprise-self-managed/ [R=301,L]

    # --- Halaman legacy ---
    RewriteRule ^cloud/cloud-platform/?$ /solution/cloud/cloud-platform/ [R=301,L]
    RewriteRule ^cloud/?$ /solution/cloud/ [R=301,L]
    RewriteRule ^hitachi/?$ /hitachi-vantara/ [R=301,L]
    # Catatan: /knowledgetedy/ dan /id/knowledgetedy/ TIDAK di-redirect karena dibuat ulang sebagai halaman ramah AI.

    # --- Slug duplikat legacy (suffix -en / -2) ---
    RewriteRule ^customer-success/pt-logisklik-gemilang-indonesia-en/?$ /customer-success/pt-logisklik-gemilang-indonesia/ [R=301,L]
    RewriteRule ^id/customer-success/landmark-retail-trading-max-fashion-2/?$ /id/customer-success/landmark-retail-trading-max-fashion/ [R=301,L]
    RewriteRule ^id/solution/security/identity-access-security-2/?$ /id/solution/security/identity-access-security/ [R=301,L]

    # --- Arsip & slug ID yang berubah ---
    RewriteRule ^id/keberhasilan-pelanggan/?$ /id/customer-success/ [R=301,L]
    RewriteRule ^id/amazon-web-services-2/?$ /id/amazon-web-services/ [R=301,L]
    RewriteRule ^id/dynatrace/pengalaman-digital/?$ /id/dynatrace/digital-experience/ [R=301,L]

    # ==========================================
    # Tambahkan trailing slash (kebalikan dari bawaan Laravel)
    # Paritas URL dengan situs WordPress lama: /about-us/ bukan /about-us
    # ==========================================

    # Jangan sentuh file & direktori fisik (asset, build, storage, dll)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Jangan sentuh endpoint yang memang tidak boleh berakhiran slash
    RewriteCond %{REQUEST_URI} ^/(ctrlpanel|api|livewire|_deferred|storage|build|themes|vendor)(/|$) [OR]
    RewriteCond %{REQUEST_URI} ^/(feed|search|lang/|forms/|indexnow-) [OR]
    RewriteCond %{REQUEST_URI} \.[a-zA-Z0-9]{1,6}$
    RewriteRule ^ - [L]

    # Sisanya: kalau belum berakhiran '/', tambahkan dengan 301
    RewriteCond %{REQUEST_URI} !/$
    RewriteRule ^(.*)$ /$1/ [R=301,L]


    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php83” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php83 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit

